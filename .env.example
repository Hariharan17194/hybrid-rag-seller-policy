# Copy to .env and edit. Every value is optional.

# Enables LLM answers. Without it the app uses extractive mode (no key needed).
OPENAI_API_KEY=

# sentence-transformers | openai | hashing  (hashing = offline, no downloads, not semantic)
EMBEDDING_PROVIDER=sentence-transformers

# Cross-encoder rerank of the top CANDIDATE_K (downloads ~1 GB on first use)
USE_RERANKER=false

TOP_K=5
CANDIDATE_K=20
RRF_K=60
LLM_MODEL=gpt-4o-mini
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# Per-domain indexes, e.g. DATA_DIR=data/banking_sample and STORAGE_DIR=storage/banking
# DATA_DIR=data/policies
# STORAGE_DIR=storage
